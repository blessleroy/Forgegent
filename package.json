{
  "name": "forgegent",
  "version": "0.1.0",
  "private": true,
  "description": "Build Agents. Ship Applications. — enterprise agent app platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b apps/runner packages/shared packages/pi-adapter packages/db packages/storage",
    "dev:web": "pnpm --filter @forgegent/web dev",
    "dev:runner": "pnpm --filter @forgegent/runner dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
